# Copy to .env.local for local overrides. Never commit real values.

# Deployment base path. The GitHub Pages workflow sets this to "/<repo-name>".
NEXT_PUBLIC_BASE_PATH=
# Canonical site URL used for metadata (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: TheMealDB supporter key for production imports (default "1" is the
# development/educational key). Used only by `npm run import:mealdb`, never
# shipped to the browser. Store it as a GitHub Actions secret, not in code.
MEALDB_API_KEY=
